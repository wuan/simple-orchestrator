{
  "name": "openspec-workflow-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "A workflow orchestrator that drives OpenSpec changes from repository issues through propose, review, approval, and apply.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "orchestrator": "./dist/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "validate": "openspec validate --strict --all && openspec validate --strict --archived",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@opencode/sdk": "^2.2.0",
    "yaml": "^2.9.1"
  }
}
