# Credentials for the orchestrator, loaded by the systemd unit as an
# EnvironmentFile. Copy to ~/.config/orchestrator/orchestrator.env, fill in the
# values, and keep it unreadable: chmod 600.
#
# systemd env files are plain KEY=value lines: no `export`, no quotes, no
# command substitution. The orchestrator never writes these values to output,
# at any verbosity.

# API key for the embedded OpenCode host (agent.model, default
# greenpt/deepseek-v4.1-flash). The variable name is agent.apiKeyEnv, default
# LLM_API_KEY. Required unless agent.database or OPENCODE_DB points at an
# OpenCode database that already holds stored provider auth.
LLM_API_KEY=

# Optional. config.yaml references `gh:token`, so the GitHub provider falls back
# to `gh auth token` when this is unset. Set it to run without a logged-in gh.
# GITHUB_TOKEN=

# Optional. Point the embedded host at the OpenCode CLI's database to reuse its
# stored auth instead of an API-key environment variable. Do not share it with a
# running OpenCode service. Find it with `opencode debug paths db`.
# OPENCODE_DB=
